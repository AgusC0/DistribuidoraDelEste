# Usuario del panel /admin (por defecto "admin")
ADMIN_USER=admin
# Contraseña del panel /admin (obligatoria en producción; en desarrollo es "admin")
ADMIN_PASSWORD=
# Clave para firmar la sesión (32+ caracteres al azar)
SESSION_SECRET=
# URL pública del sitio (para SEO: sitemap, Open Graph, datos estructurados)
NEXT_PUBLIC_SITE_URL=https://distribuidoradeleste.com.ar
# Carpeta donde se guarda la base de datos y las fotos (por defecto ./data)
# DATA_DIR=
# Avisos por email de cada consulta (https://resend.com, plan gratis)
RESEND_API_KEY=
# Remitente con dominio verificado en Resend (sin esto sólo envía al email de la cuenta de Resend)
# EMAIL_FROM=Web Distribuidora <avisos@distribuidoradeleste.com.ar>
